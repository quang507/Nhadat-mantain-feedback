# Mật khẩu đăng nhập trang quản trị (BQL dùng chung). Bắt buộc.
ADMIN_PASSWORD=
# Chuỗi bí mật để ký cookie đăng nhập và token QR. Bắt buộc. Sinh bằng: openssl rand -hex 32
APP_SECRET=

# Lưu dữ liệu lên GitHub (nhánh riêng, không trigger deploy).
# Bỏ trống khi chạy máy local -> dữ liệu lưu vào thư mục .data/
GITHUB_TOKEN=
GITHUB_OWNER=quang507
GITHUB_REPO=Nhadat-mantain-feedback
GITHUB_DATA_BRANCH=feedback-logs

# Zalo OA (tùy chọn - chưa có vẫn chạy được, BQL gửi link tay qua Zalo)
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_SECRET=

# Báo nội bộ cho BQL (tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# DATA_LOCAL=1 -> luôn ghi vào .data/ dù máy có GITHUB_TOKEN (dùng khi chạy thử)
DATA_LOCAL=
